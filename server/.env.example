# Отримати токен: @BotFather → /newbot. Chat id: напишіть боту, потім відкрийте
# https://api.telegram.org/bot<TOKEN>/getUpdates і візьміть message.chat.id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 1 — якщо сервер за nginx / проксі платформи
TRUST_PROXY=0
# у продакшені краще redis://localhost:6379
RATELIMIT_STORAGE_URI=memory://
# шлях до зібраного фронтенду, щоб Flask віддавав і сайт
STATIC_DIR=../dist
